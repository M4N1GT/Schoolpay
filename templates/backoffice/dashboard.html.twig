{% extends 'backoffice/layout.html.twig' %}

{% block title %}Tableau de bord | SchoolPay{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block content %}
<div class="stats-row">
    <div class="stat-card"><span class="stat-value">{{ overview.students }}</span><span class="stat-label">Eleves</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.expected|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Montant attendu</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.paid|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Encaisse</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.collectionRate }}%</span><span class="stat-label">Recouvrement</span></div>
</div>
<div class="cards-grid">
    <section class="panel">
        <h2>Paiements recents</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Numero</th><th>Eleve</th><th>Montant</th><th>Statut</th></tr></thead>
                <tbody>
                {% for payment in recentPayments %}
                    <tr>
                        <td>{{ payment.paymentNumber }}</td>
                        <td>{{ payment.student.fullName }}</td>
                        <td>{{ payment.totalAmount|number_format(0, ',', ' ') }} Ar</td>
                        <td><span class="badge">{{ payment.status }}</span></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">Aucun paiement.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    <section class="panel">
        <h2>Activite recente</h2>
        <div class="table-wrap">
            <table>
                <tbody>
                {% for audit in recentAudits %}
                    <tr><td>{{ audit.createdAt|date('d/m/Y H:i') }}</td><td>{{ audit.action }}</td><td>{{ audit.description }}</td></tr>
                {% else %}
                    <tr><td>Aucune activite.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
