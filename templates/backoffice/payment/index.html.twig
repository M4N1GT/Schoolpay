{% extends 'backoffice/layout.html.twig' %}

{% block page_title %}Paiements{% endblock %}

{% block content %}
{% if is_granted('MANAGE', 'payments') %}
    <div class="actions"><a class="button" href="{{ path('backoffice_payment_new') }}">Nouveau paiement</a></div>
{% endif %}
<form method="get" class="panel grid-form" style="margin-top: 16px;">
    <div>
        <label for="q">Recherche</label>
        <input id="q" name="q" value="{{ app.request.query.get('q') }}" placeholder="Numero, reference, eleve...">
    </div>
    <div>
        <label for="method">Mode</label>
        <select id="method" name="method">
            <option value="">Tous</option>
            {% for method in methods %}
                <option value="{{ method }}" {{ app.request.query.get('method') == method ? 'selected' : '' }}>{{ method }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label for="status">Statut</label>
        <select id="status" name="status">
            <option value="">Tous</option>
            {% for status in statuses %}
                <option value="{{ status }}" {{ app.request.query.get('status') == status ? 'selected' : '' }}>{{ status }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label for="from">Du</label>
        <input id="from" type="date" name="from" value="{{ app.request.query.get('from') }}">
    </div>
    <div>
        <label for="to">Au</label>
        <input id="to" type="date" name="to" value="{{ app.request.query.get('to') }}">
    </div>
    <div class="actions">
        <button>Filtrer</button>
        {{ include('_partials/filter_reset.html.twig') }}
    </div>
</form>
<section class="table-panel" style="margin-top: 16px;">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Numero</th>
                    <th>{{ include('_partials/sortable_header.html.twig', {label: 'date', sortable: {'date': 'p.paymentDate'}}) }}</th>
                    <th>{{ include('_partials/sortable_header.html.twig', {label: 'eleve', sortable: {'eleve': 's.lastName'}}) }}</th>
                    <th>{{ include('_partials/sortable_header.html.twig', {label: 'montant', sortable: {'montant': 'p.totalAmount'}}) }}</th>
                    <th>Methode</th><th>Statut</th><th>Recu</th><th>Annulation</th>
                </tr>
            </thead>
            <tbody>
            {% for payment in payments %}
                <tr>
                    <td>{{ payment.paymentNumber }}</td>
                    <td>{{ payment.paymentDate|date('d/m/Y H:i') }}</td>
                    <td>{{ payment.student.fullName }}</td>
                    <td>{{ payment.totalAmount|number_format(0, ',', ' ') }} Ar</td>
                    <td>{{ payment.paymentMethod }}</td>
                    <td><span class="badge {{ payment.status == 'annule' ? 'danger' : 'ok' }}">{{ payment.status }}</span></td>
                    <td>{% if payment.receipt %}<a class="button ghost" href="{{ path('backoffice_receipt_print', {id: payment.receipt.id}) }}">Imprimer</a>{% endif %}</td>
                    <td>
                        {% if payment.status != 'annule' %}
                            {% if is_granted('MANAGE', 'payments') %}
                                <form method="post" action="{{ path('backoffice_payment_cancel', {id: payment.id}) }}" class="actions">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_payment_' ~ payment.id) }}">
                                    <input name="reason" placeholder="Motif" required>
                                    <button class="danger" data-confirm="Annuler ce paiement ?">Annuler</button>
                                </form>
                            {% endif %}
                        {% else %}
                            {{ payment.cancellationReason }}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8">Aucun paiement.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {{ include('_partials/pagination.html.twig') }}
</section>
{% endblock %}
