{% extends 'backoffice/layout.html.twig' %}

{% block title %}Rapports | SchoolPay{% endblock %}
{% block page_title %}Rapports{% endblock %}

{% block content %}
<div class="stats-row">
    <div class="stat-card"><span class="stat-value">{{ overview.expected|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Attendu</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.paid|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Encaisse</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.remaining|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Reste</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.collectionRate }}%</span><span class="stat-label">Recouvrement</span></div>
</div>

<section class="panel" style="margin-top: 18px;">
    <h2>Choisir un rapport</h2>
    <p class="muted">Chaque rapport s ouvre sur l annee civile en cours et accepte une periode personnalisee, l impression et l export CSV.</p>
    <div class="cards-grid" style="margin-top: 12px;">
        {% for key, label in catalogue %}
            <a class="panel report-link" href="{{ path('backoffice_report_show', {key: key, from: defaultPeriod.from, to: defaultPeriod.to}) }}">
                <strong>{{ label }}</strong>
            </a>
        {% endfor %}
    </div>
</section>
{% endblock %}
