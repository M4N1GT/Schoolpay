{% extends 'backoffice/layout.html.twig' %}

{% block page_title %}Rapports{% endblock %}

{% block content %}
<div class="stats-row">
    <div class="stat-card"><span class="stat-value">{{ overview.expected|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Attendu</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.paid|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Encaisse</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.remaining|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Reste</span></div>
    <div class="stat-card"><span class="stat-value">{{ overview.collectionRate }}%</span><span class="stat-label">Taux</span></div>
</div>
<section class="table-panel" style="margin-top: 18px;">
    <h2>Rapport des paiements</h2>
    <table>
        <thead><tr><th>Date</th><th>Eleve</th><th>Methode</th><th>Montant</th><th>Statut</th></tr></thead>
        <tbody>
        {% for payment in payments %}
            <tr><td>{{ payment.paymentDate|date('d/m/Y') }}</td><td>{{ payment.student.fullName }}</td><td>{{ payment.paymentMethod }}</td><td>{{ payment.totalAmount|number_format(0, ',', ' ') }} Ar</td><td>{{ payment.status }}</td></tr>
        {% else %}
            <tr><td colspan="5">Aucune donnee.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {{ include('_partials/pagination.html.twig') }}
</section>
{% endblock %}
