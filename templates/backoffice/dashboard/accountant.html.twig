{% extends 'backoffice/layout.html.twig' %}

{% block title %}Tableau de bord | SchoolPay{% endblock %}
{% block page_title %}Tableau de bord caisse{% endblock %}

{% block content %}
<div class="actions">
    <a class="button" href="{{ path('backoffice_payment_new') }}">Nouveau paiement</a>
    <a class="button ghost" href="{{ path('backoffice_outstanding_index') }}">Eleves en retard</a>
</div>

<div class="stats-row" style="margin-top: 16px;">
    <div class="stat-card"><span class="stat-value">{{ today.total|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Encaisse aujourd hui</span></div>
    <div class="stat-card"><span class="stat-value">{{ today.count }}</span><span class="stat-label">Paiements du jour</span></div>
    <div class="stat-card"><span class="stat-value">{{ month.total|number_format(0, ',', ' ') }} Ar</span><span class="stat-label">Encaisse ce mois</span></div>
    <div class="stat-card"><span class="stat-value">{{ month.count }}</span><span class="stat-label">Paiements du mois</span></div>
</div>

<section class="panel" style="margin-top: 18px;">
    <h2>Repartition par mode de paiement</h2>
    {{ include('_partials/bar_chart.html.twig', {series: byMethod, empty: 'Aucun encaissement enregistre.'}) }}
</section>

<div class="cards-grid" style="margin-top: 18px;">
    <section class="panel">
        <h2>Paiements recents</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Date</th><th>Eleve</th><th>Montant</th><th>Mode</th></tr></thead>
                <tbody>
                {% for payment in recentPayments %}
                    <tr>
                        <td>{{ payment.paymentDate|date('d/m H:i') }}</td>
                        <td>{{ payment.student.fullName }}</td>
                        <td>{{ payment.totalAmount|number_format(0, ',', ' ') }} Ar</td>
                        <td>{{ payment.paymentMethod }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">Aucun paiement.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    <section class="panel">
        <h2>Recus recents</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Numero</th><th>Eleve</th><th></th></tr></thead>
                <tbody>
                {% for receipt in recentReceipts %}
                    <tr>
                        <td>{{ receipt.receiptNumber }}</td>
                        <td>{{ receipt.payment.student.fullName }}</td>
                        <td><a class="button ghost" href="{{ path('backoffice_receipt_print', {id: receipt.id}) }}">Imprimer</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="3">Aucun recu.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
