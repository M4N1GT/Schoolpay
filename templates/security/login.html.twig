{% extends 'base.html.twig' %}

{% block title %}Connexion | SchoolPay{% endblock %}

{% block body %}
<div class="public-shell">
    <nav class="public-nav">
        <a class="brand" href="{{ path('app_home') }}">SchoolPay</a>
    </nav>
    <section class="public-hero">
        <h1>Connexion</h1>
        <p>Accedez au back-office ou a l espace parent selon votre role.</p>
        <form method="post" class="panel grid-form" style="max-width: 440px;">
            {% if error %}
                <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <div>
                <label for="email">Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="email" autocomplete="email" required autofocus>
            </div>
            <div>
                <label for="password">Mot de passe</label>
                <input type="password" name="password" id="password" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Se connecter</button>
        </form>
    </section>
</div>
{% endblock %}
