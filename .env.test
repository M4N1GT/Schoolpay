# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'

# Symfony ne charge PAS .env.local en environnement de test : il faut redonner
# ici l'URL de la base, sinon les tests visent le port 5432 par defaut alors que
# compose.override.yaml expose PostgreSQL sur 5433. Doctrine ajoute le suffixe
# "_test" au nom de la base (voir config/packages/doctrine.yaml).
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5433/app?serverVersion=16&charset=utf8"
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
